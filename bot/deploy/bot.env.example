# Заготовка ~/bot-eneshka/bot.env на сервере Енешки (права 600). Секретов здесь нет: их пустые строки
# заполняют на сервере - ключи Андрей вписывает сам (bash vpisat.sh ИМЯ, ввод без показа),
# UCHET_SERVICE_KEY и UZEL_WEBHOOK_SECRET пишут скрипты дня установки (den-ustanovki.sh).
# BOT_MODE=silent - бот слушает WhatsApp и считает обращения, но никому не отвечает. Это замок на сервере:
# пока строка здесь, настройки учёта бота не разговорят. Убрать её - осознанное решение владельца.
BOT_MODE=silent
UZEL_BASE_URL=https://uzel.eneshka.kz
UZEL_API_KEY=
UZEL_WEBHOOK_SECRET=
UCHET_API_URL=https://qeehxcnnuzuwskznhdyg.supabase.co/functions/v1/uchet
UCHET_SERVICE_KEY=
ANTHROPIC_API_KEY=
# В тихом режиме ключ Anthropic и четыре строки Telegram не нужны - бот их не трогает.
BOT_MODEL=claude-sonnet-5-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
PUBLIC_BASE_URL=https://bot.eneshka.kz
